# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@livebook:5433/spms

# Secret for signing session tokens (jose). Generate with: openssl rand -hex 32
SESSION_SECRET=

# Static bearer key for the MCP endpoint. Generate with: openssl rand -hex 32
MCP_API_KEY=

# AES-256-GCM key for encrypting sensitive DB-stored config (OAuth app
# secrets from 设置→三方登录, storage credentials from 设置→文件存储).
# Generate with: openssl rand -hex 32
CONFIG_CRYPTO_KEY=

# Public origin of the deployment, no trailing slash. Required when the app
# runs behind a reverse proxy that rewrites the Host header — OAuth redirect
# URIs (Feishu/Lark/GitHub/Notion) and post-login redirects are built from it.
# PUBLIC_ORIGIN=https://spms.innev.cn

# Feishu (飞书, CN) OAuth login — optional fallback. Prefer configuring these
# in 设置 → 三方登录 (platform admin); a DB row takes precedence and its secret
# is stored encrypted. Env stays as the fallback when no DB row exists.
# App console: https://open.feishu.cn/app
# 权限管理需开通（改动后须创建版本并发布才生效）：
#   contact:user.base:readonly  — 昵称/头像
#   contact:user.email:readonly — 邮箱（认领外部邀请的匹配键之一）
#   contact:user.phone:readonly — 手机号（无邮箱账号的认领键，可选）
# 另需在「安全设置」把完整回调地址（PUBLIC_ORIGIN + 下方路径）加入重定向 URL。
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_REDIRECT_URI=/api/auth/feishu/callback

# Lark (international) OAuth login — optional. Leave empty to hide the Lark button.
# App console: https://open.larksuite.com/app — same scopes as Feishu above.
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_REDIRECT_URI=/api/auth/lark/callback

# GitHub OAuth login (OAuth App) — optional. Leave empty to hide the GitHub button.
# App console: https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=/api/auth/github/callback

# Notion integration (public OAuth) — optional. Leave empty to disable the
# settings-page connect button. Create a public integration at
# https://www.notion.so/profile/integrations (capabilities: Read content +
# Read user information) and set its redirect URI to
# <PUBLIC_ORIGIN>/api/v1/pms/integrations/notion/callback.
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=/api/v1/pms/integrations/notion/callback

# Seed-only: overrides the default admin password ('admin123')
# SEED_ADMIN_PASSWORD=

# Vercel Blob token — DEPRECATED at runtime. File storage is now configured
# per company in 设置 → 文件存储 (MinIO or Vercel Blob, credentials stored
# encrypted in the DB). A company without a storage config cannot upload.
# This env var is no longer read by the app; kept here only as a reference
# for existing tokens you may want to copy into a company's storage config.
# BLOB_READ_WRITE_TOKEN=
