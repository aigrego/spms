# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@livebook:5433/next_spms

# Secret for signing session tokens (jose). Generate with: openssl rand -hex 32
SESSION_SECRET=

# Static bearer key for the MCP endpoint. Generate with: openssl rand -hex 32
MCP_API_KEY=

# Feishu (飞书, CN) OAuth login — optional. Leave empty to hide the 飞书 button.
# App console: https://open.feishu.cn/app
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback

# Lark (international) OAuth login — optional. Leave empty to hide the Lark button.
# App console: https://open.larksuite.com/app
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_REDIRECT_URI=http://localhost:3000/api/auth/lark/callback

# GitHub OAuth login (OAuth App) — optional. Leave empty to hide the GitHub button.
# App console: https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# Notion integration (public OAuth) — optional. Leave empty to disable the
# settings-page connect button. Create a public integration at
# https://www.notion.so/profile/integrations (capabilities: Read content +
# Read user information) and set its redirect URI to
# <origin>/api/v1/pms/integrations/notion/callback.
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=http://localhost:3000/api/v1/pms/integrations/notion/callback

# Seed-only: overrides the default admin password ('admin123')
# SEED_ADMIN_PASSWORD=

# Vercel Blob (issue image attachments). Get the token from the Vercel
# dashboard → Storage → Blob, or run `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
